# OpenClaw Trader - Environment Configuration (Test)
# This is a TEST configuration with minimal settings

# ============================================
# DATABASE (Required for production, optional for MVP test)
# ============================================
DB_URL_TRADER=postgresql://trader_user:trader_pass_dev_only@localhost:5433/openclaw_trader

# ============================================
# BROKER (Alpaca Paper Trading)
# ============================================
BROKER_API_KEY=PKBTHNJSXAO4HX2UNG5SOEI6WO
BROKER_API_SECRET=E9XQb43PYJ3CJmsTzzZiFrbAGjKCGKhcBeq49UdkQ2KU
BROKER_BASE_URL=https://paper-api.alpaca.markets

# ============================================
# TRADING MODE
# ============================================
TRADING_MODE=paper

# ============================================
# RISK CONFIGURATION
# ============================================
# Set to false to allow orders outside market hours (useful for testing)
ENFORCE_MARKET_HOURS=false

# ============================================
# RISK LIMITS — Paper Trading (current)
# ============================================
RISK_MAX_DAILY_LOSS=500
RISK_MAX_POSITION_USD=2000
RISK_MAX_GROSS_EXPOSURE_USD=5000
RISK_MAX_TRADES_PER_DAY=10

# ============================================
# RISK LIMITS — Live $50 Account (activate when fund-ready)
# Survives 10 consecutive max-loss days
# To activate: set TRADING_MODE=live and uncomment below
# ============================================
# RISK_MAX_DAILY_LOSS=5
# RISK_MAX_POSITION_USD=10
# RISK_MAX_GROSS_EXPOSURE_USD=25
# RISK_MAX_TRADES_PER_DAY=5

# ============================================
# KILL SWITCH
# ============================================
KILL_SWITCH_ENABLED=true
KILL_SWITCH_DEFAULT_MODE=soft

# ============================================
# CONSOLE JWT
# ============================================
CONSOLE_JWT_ISSUER=openclaw-console
CONSOLE_JWT_AUDIENCE=trader-service

# ============================================
# SERVER
# ============================================
PORT=3002
METRICS_PORT=9090
NODE_ENV=development

# ============================================
# OLLAMA (Local LLM — $0/run)
# ============================================
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_DEFAULT_MODEL=llama3.2:3b

# ============================================
# AI PANEL
# ============================================
PANEL_INTERVAL_MS=180000
PANEL_DRY_RUN=false
FORCE_MARKET_HOURS=true

# ============================================
# LLM API KEYS (for Tier 1+2 analysts)
# ============================================
GROK_API_KEY=your-xai-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ============================================
# POLYMARKET (Prediction Markets — optional)
# ============================================
# Leave blank to run in read-only mode (market browsing only, no trades)
# To enable live trading: add your Polygon wallet private key + Polymarket API creds
# Get API keys at: https://polymarket.com/settings/api
# POLYMARKET_PRIVATE_KEY=0x...your_polygon_wallet_private_key
# POLYMARKET_API_KEY=your_api_key
# POLYMARKET_API_SECRET=your_api_secret
# POLYMARKET_API_PASSPHRASE=your_passphrase
POLYMARKET_BASE_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_RPC_URL=https://polygon-rpc.com
POLYMARKET_MAX_EXPOSURE_USD=500
POLYMARKET_MIN_ORDER_SIZE=5
POLYMARKET_MAX_ORDER_SIZE=500

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CONSOLE JWT AUTHENTICATION
# ============================================
# IMPORTANT: For production, generate a real RSA keypair:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -outform PEM -pubout -out public.pem
# Then paste the public key here
# CONSOLE_JWT_PUBLIC_KEY= (leave blank for dev — auth bypass active)
CONSOLE_JWT_ISSUER=openclaw-console
CONSOLE_URL=http://localhost:5174

# ═══════════════════════════════════════════════════════════════
# WEATHER TRADING — NOAA × Polymarket
# ═══════════════════════════════════════════════════════════════
WEATHER_TRADING_ENABLED=false
WEATHER_SCAN_INTERVAL_MS=120000
WEATHER_ENTRY_THRESHOLD=0.15
WEATHER_EXIT_THRESHOLD=0.45
WEATHER_MAX_POSITION_USD=2.00
WEATHER_MAX_EXPOSURE_USD=50
WEATHER_CITIES=nyc,chicago,seattle,atlanta,dallas,miami
WEATHER_STOP_LOSS=0.03
WEATHER_MAX_TRADES_PER_SCAN=5
WEATHER_MIN_LIQUIDITY=100
WEATHER_MIN_EDGE=0.20

