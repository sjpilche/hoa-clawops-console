{
  "_doc": "Permission tiers for the OpenClaw agent fleet. See docs/LEAST_PRIVILEGE_GOVERNANCE.md for full model.",
  "_updated": "2026-03-14",

  "tiers": {
    "0": {
      "name": "Read Only",
      "grants": ["db_read"],
      "description": "Frozen agents + pure classifiers. Can read DB, nothing else."
    },
    "1": {
      "name": "Internal Writer",
      "grants": ["db_read", "db_write"],
      "description": "Deterministic handlers that read and write to internal DB. No external access, no LLM."
    },
    "2": {
      "name": "Scraper",
      "grants": ["db_read", "db_write", "playwright"],
      "description": "Playwright-based web scrapers. Can read public websites + write results to DB."
    },
    "3": {
      "name": "LLM Agent",
      "grants": ["db_read", "db_write", "llm_inference", "shell_spawn", "discord_notify"],
      "description": "LLM-powered agents via OpenClaw bridge. Can generate text, write drafts, send Discord alerts."
    },
    "4": {
      "name": "External Send",
      "grants": ["db_read", "db_write", "llm_inference", "shell_spawn", "discord_notify", "external_api_write"],
      "description": "Can post to external APIs (Facebook, GitHub). Highest agent-level permission."
    },
    "5": {
      "name": "System",
      "grants": ["db_read", "db_write", "llm_inference", "shell_spawn", "discord_notify", "file_write", "external_api_read"],
      "description": "System-level agents (backup, training, transcript extraction). Full internal access."
    }
  },

