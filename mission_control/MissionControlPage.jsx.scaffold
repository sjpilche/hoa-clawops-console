/**
 * Mission Control — main page component.
 *
 * Render order:
 * 1. useDashboardData() — aggregates all API data
 * 2. useActivityFeed() — manages run stream + Socket.io
 * 3. Passes data down to panel components via props
 * 4. No business logic in JSX — all logic in hooks and utility functions
 */
