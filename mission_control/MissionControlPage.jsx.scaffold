        <FileText size={14} className="text-accent-info" />
        <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">Content Engine</span>
      </div>

      {/* Metrics */}
      <div className="grid grid-cols-2 gap-x-2 gap-y-1 flex-1">
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">This week</span>
          <span className="text-sm font-bold text-text-primary">{data.this_week}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Published</span>
          <span className="text-sm font-bold text-green-400">{data.published}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Drafts</span>
          <span className="text-sm font-bold text-yellow-400">{data.drafted}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Scheduled</span>
          <span className="text-sm font-bold text-text-primary">{data.scheduled}</span>
        </div>
        <div className="col-span-2 flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Social/week</span>
          <span className="text-sm font-bold text-text-primary">{data.social_posts_week}</span>
        </div>
      </div>

      {/* Last published */}
      {data.last_published_title && (
        <div className="text-[10px] text-text-muted truncate mb-1" title={data.last_published_title}>
          Last: "{data.last_published_title?.slice(0, 32)}..." — {timeAgo(data.last_published_at)}
        </div>
      )}

      {/* Channel badges */}
      <div className="flex flex-wrap gap-1">
        {(data.channels_active || []).map(ch => (
          <span key={ch} className={`text-[9px] px-1.5 py-0.5 rounded font-semibold uppercase ${CHANNEL_STYLES[ch] || 'bg-gray-500/20 text-gray-400'}`}>
            {ch}
          </span>
        ))}
      </div>
    </div>
  );
}

// ============================================================================
// COMPONENT: OpportunityPanel
// ============================================================================
/**
 * Revenue Experiments panel — ICE-scored opportunity tracker.
 *
 * @param {{ data: object, onAddIdea: () => void }} props — data = summary.opportunities
 */
function OpportunityPanel({ data, onAddIdea }) {
  const iceColor = data.top_opportunity?.ice_score >= 70 ? 'text-green-400 bg-green-400/10'
    : data.top_opportunity?.ice_score >= 50 ? 'text-yellow-400 bg-yellow-400/10'
    : 'text-gray-400 bg-gray-400/10';
  const iceLabel = data.top_opportunity?.ice_score >= 70 ? 'Execute Now'
    : data.top_opportunity?.ice_score >= 50 ? 'This Week' : 'Backlog';

  return (
    <div className="col-span-3 bg-bg-surface border border-border-subtle rounded-lg p-3 flex flex-col h-48">
      {/* Header */}
      <div className="flex items-center justify-between mb-2">
        <div className="flex items-center gap-2">
          <TrendingUp size={14} className="text-accent-warning" />
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">Experiments</span>
        </div>
        <button
          onClick={onAddIdea}
          className="text-[10px] text-text-muted hover:text-accent-primary transition-colors flex items-center gap-0.5"
          title="Add new idea"
        >
          <Plus size={10} /> Idea
        </button>
      </div>

      {/* Top opportunity */}
      {data.top_opportunity && (
        <div className="mb-2 p-2 rounded bg-bg-elevated border border-border-subtle">
          <div className="flex items-center justify-between mb-0.5">
            <span className={`text-[9px] px-1.5 py-0.5 rounded font-bold uppercase ${iceColor}`}>
              ICE {data.top_opportunity.ice_score} · {iceLabel}
            </span>
          </div>
          <div className="text-xs text-text-primary font-medium truncate">{data.top_opportunity.name}</div>
        </div>
      )}

      {/* Metrics grid */}
      <div className="grid grid-cols-2 gap-x-2 gap-y-1 flex-1">
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Active</span>
          <span className="text-sm font-bold text-text-primary">{data.active}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Evaluating</span>
          <span className="text-sm font-bold text-yellow-400">{data.evaluating}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Converted</span>
          <span className={`text-sm font-bold ${data.converted > 0 ? 'text-green-400' : 'text-text-muted'}`}>{data.converted}</span>
        </div>
        <div className="flex items-center justify-between">
          <span className="text-[11px] text-text-muted">Score &gt; 60</span>
          <span className="text-sm font-bold text-text-primary">{data.ideas_above_60}</span>
        </div>
      </div>

      <div className="text-[10px] text-text-muted">
        Last idea: {data.days_since_new_idea === 0 ? 'today' : `${data.days_since_new_idea}d ago`}
      </div>
    </div>
  );
}

// ============================================================================
// COMPONENT: ActivityFeed
// ============================================================================
/**
 * Live agent run stream.
 *
 * Phase 1: shows empty state.
 * Phase 2: hydrated from GET /api/runs?limit=25.
 * Phase 3: real-time via Socket.io.
 *
 * @param {{ runs: Array, connected: boolean }} props
 */
function ActivityFeed({ runs, connected }) {
  const navigate = useNavigate();

  const STATUS_STYLES = {
    completed: { dot: 'bg-green-400',       row: '',                    icon: CheckCircle2 },
    failed:    { dot: 'bg-red-400',         row: 'bg-red-400/5',        icon: XCircle },
    running:   { dot: 'bg-blue-400 animate-pulse', row: 'bg-blue-400/5', icon: Loader },
    pending:   { dot: 'bg-yellow-400',      row: '',                    icon: Timer },
    cancelled: { dot: 'bg-gray-400',        row: '',                    icon: XCircle },
  };

  // Phase 1 mock runs for layout verification
  const MOCK_RUNS = [
    { id: '1', agent_name: 'jake-contact-enricher', status: 'completed', result_data: '{"outputText":"23/30 enriched — Tampa Bay, FL"}', cost_usd: 0, created_at: new Date(Date.now() - 2 * 60000).toISOString() },
    { id: '2', agent_name: 'hoa-discovery',         status: 'completed', result_data: '{"outputText":"South Florida: 568 HOAs, 162 queries"}', cost_usd: 0, created_at: new Date(Date.now() - 53 * 3600000).toISOString() },
    { id: '3', agent_name: 'daily-debrief',         status: 'running',   result_data: '{"outputText":"Generating debrief..."}',           cost_usd: 0.01, created_at: new Date().toISOString() },
    { id: '4', agent_name: 'jake-lead-scout',       status: 'failed',    error_msg: 'Agent timed out after 300s',                        cost_usd: 0.02, created_at: new Date(Date.now() - 5 * 60000).toISOString() },
    { id: '5', agent_name: 'brain-distillation',    status: 'completed', result_data: '{"outputText":"8 new KB entries, 47 observations"}', cost_usd: 0, created_at: new Date(Date.now() - 11 * 3600000).toISOString() },
  ];

  const displayRuns = runs.length > 0 ? runs : MOCK_RUNS;

  function getSummary(runRow) {
    if (runRow.error_msg) return runRow.error_msg;
    try {
      const rd = JSON.parse(runRow.result_data || '{}');
      return rd.outputText || rd.output || '—';
    } catch { return '—'; }
  }

  return (
    <div className="col-span-7 bg-bg-surface border border-border-subtle rounded-lg flex flex-col overflow-hidden">
      {/* Feed header */}
      <div className="flex items-center justify-between px-3 py-2 border-b border-border-subtle flex-shrink-0">
        <div className="flex items-center gap-2">
          <Activity size={13} className="text-accent-primary" />
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">Live Activity</span>
          {connected && <div className="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" title="Real-time" />}
        </div>
        <span className="text-[10px] text-text-muted">Last {displayRuns.length} runs</span>
      </div>

      {/* Run entries */}
      <div className="flex-1 overflow-y-auto">
        {displayRuns.length === 0 ? (
          <div className="flex items-center justify-center h-full text-text-muted text-xs">
            No runs yet — agents will appear here when they fire
          </div>
        ) : (
          displayRuns.map((runRow) => {
            const style  = STATUS_STYLES[runRow.status] || STATUS_STYLES.pending;
            const Icon   = style.icon;
            const summary = getSummary(runRow);

            return (
              <div
                key={runRow.id}
                onClick={() => navigate(`/monitor?run=${runRow.id}`)}
                className={`flex items-center gap-2 px-3 py-2 border-b border-border-subtle cursor-pointer hover:bg-bg-elevated transition-colors ${style.row}`}
              >
                {/* Status indicator */}
                <div className={`w-2 h-2 rounded-full flex-shrink-0 ${style.dot}`} />

                {/* Agent name */}
                <span className="text-xs font-medium text-text-secondary w-36 flex-shrink-0 truncate">
                  {runRow.agent_name}
                </span>

                {/* Summary */}
                <span className="text-xs text-text-muted flex-1 truncate">{summary}</span>

                {/* Cost */}
                <span className={`text-xs flex-shrink-0 w-12 text-right ${runRow.cost_usd > 0.1 ? 'text-accent-warning' : 'text-text-muted'}`}>
                  {runRow.cost_usd > 0 ? formatCost(runRow.cost_usd) : '—'}
                </span>

                {/* Time ago */}
                <span className="text-[10px] text-text-muted flex-shrink-0 w-14 text-right">
                  {timeAgo(runRow.created_at)}
                </span>
              </div>
            );
          })
        )}
      </div>
    </div>
  );
}

// ============================================================================
// COMPONENT: TopThreePanel
// ============================================================================
/**
 * Today's top 3 tasks from Todd's reverse prompt engine.
 *
 * Phase 1: shows mock tasks.
 * Phase 4: populated from summary.top_tasks via Todd's daily-debrief run.
 *
 * @param {{ tasks: Array, generatedAt: string|null, onRunTask: (task: object) => void }} props
 */
function TopThreePanel({ tasks, generatedAt, onRunTask }) {
  const PRIORITY_STYLES = {
    'EXECUTE NOW': 'text-green-400 bg-green-400/10 border border-green-400/20',
    'THIS WEEK':   'text-yellow-400 bg-yellow-400/10 border border-yellow-400/20',
    'BACKLOG':     'text-gray-400 bg-gray-400/10 border border-gray-400/20',
  };

  return (
    <div className="flex-[2] bg-bg-surface border border-border-subtle rounded-lg p-3 flex flex-col overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between mb-2 flex-shrink-0">
        <div className="flex items-center gap-2">
          <Target size={13} className="text-accent-primary" />
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">Today's Priorities</span>
        </div>
        {generatedAt && (
          <span className="text-[10px] text-text-muted">Todd · {timeAgo(generatedAt)}</span>
        )}
      </div>

      {/* Task cards */}
      {tasks.length === 0 ? (
        <div className="flex-1 flex flex-col items-center justify-center gap-2 text-center">
          <Bot size={20} className="text-text-muted" />
          <p className="text-xs text-text-muted">No priorities yet today.</p>
          <p className="text-[11px] text-text-muted">Run Todd to generate today's ranked task list.</p>
        </div>
      ) : (
        <div className="flex flex-col gap-1.5 flex-1 overflow-y-auto">
          {tasks.slice(0, 3).map((task) => (
            <div
              key={task.rank}
              className="p-2 rounded bg-bg-elevated border border-border-subtle flex flex-col gap-1"
            >
              <div className="flex items-center justify-between">
                <span className={`text-[9px] px-1.5 py-0.5 rounded font-bold uppercase ${PRIORITY_STYLES[task.priority] || PRIORITY_STYLES['BACKLOG']}`}>
                  #{task.rank} {task.priority}
                </span>
                <span className="text-[10px] text-text-muted">Score: {task.score}</span>
              </div>
              <div className="text-xs text-text-primary font-medium leading-tight truncate">{task.title}</div>
              <div className="flex items-center justify-between">
                <span className="text-[10px] text-text-muted truncate flex-1">{task.agent} · {task.estimated_cost_usd > 0 ? formatCost(task.estimated_cost_usd) : '$0'}</span>
                <button
                  onClick={() => onRunTask(task)}
                  className="flex items-center gap-1 text-[10px] px-2 py-0.5 rounded bg-accent-primary/10 hover:bg-accent-primary/20 text-accent-primary transition-colors flex-shrink-0 ml-2"
                >
                  <PlayCircle size={10} />
                  Run
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ============================================================================
// COMPONENT: MemoryPulse
// ============================================================================
/**
 * Collective Brain health panel.
 *
 * @param {{ data: object }} props — data = summary.brain
 */
function MemoryPulse({ data }) {
  const HEALTH_STYLES = {
    LEARNING: 'text-green-400 bg-green-400/10 border-green-400/30',
    STABLE:   'text-yellow-400 bg-yellow-400/10 border-yellow-400/30',
    STALE:    'text-red-400 bg-red-400/10 border-red-400/30',
  };

  const healthStyle = HEALTH_STYLES[data.health] || HEALTH_STYLES.STALE;
  const fbTotal = data.feedback_total || 1;
  const approvedPct = Math.round((data.feedback_approved / fbTotal) * 100);

  return (
    <div className="flex-[3] bg-bg-surface border border-border-subtle rounded-lg p-3 flex flex-col overflow-hidden">
      {/* Header */}
      <div className="flex items-center justify-between mb-2 flex-shrink-0">
        <div className="flex items-center gap-2">
          <Brain size={13} className="text-accent-primary" />
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">Memory Pulse</span>
        </div>
        <span className={`text-[10px] px-2 py-0.5 rounded border font-bold uppercase ${healthStyle}`}>
          {data.health}
        </span>
      </div>

      {/* Two-column layout */}
      <div className="grid grid-cols-2 gap-x-3 flex-1 overflow-hidden">
        {/* Left — brain stats */}
        <div className="flex flex-col gap-1.5">
          <div className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted">Observations / 7d</span>
            <span className="text-sm font-bold text-text-primary">{data.observations_7d}</span>
          </div>
          <div className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted">KB entries</span>
            <span className="text-sm font-bold text-text-primary">{data.kb_total}</span>
          </div>
          <div className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted">KB retrievals</span>
            <span className="text-sm font-bold text-text-primary">{data.kb_total_uses}</span>
          </div>
          <div className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted">Episodes</span>
            <span className="text-sm font-bold text-text-primary">{data.episodes_total}</span>
          </div>
          <div className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted">Avg outcome</span>
            <span className={`text-sm font-bold ${(data.episodes_avg_score ?? 0) > 0.6 ? 'text-green-400' : (data.episodes_avg_score ?? 0) > 0.4 ? 'text-yellow-400' : 'text-red-400'}`}>
              {data.episodes_avg_score != null ? `${Math.round(data.episodes_avg_score * 100)}%` : '—'}
            </span>
          </div>
        </div>

        {/* Right — feedback signals */}
        <div className="flex flex-col gap-1.5">
          <div className="text-[10px] text-text-muted mb-0.5">Feedback signals</div>
          <div className="flex items-center gap-1.5">
            <ThumbsUp size={11} className="text-green-400 flex-shrink-0" />
            <div className="flex-1 h-1.5 bg-bg-elevated rounded-full overflow-hidden">
              <div className="h-full bg-green-400 rounded-full transition-all" style={{ width: `${approvedPct}%` }} />
            </div>
            <span className="text-[10px] text-green-400 w-6 text-right">{data.feedback_approved}</span>
          </div>
          <div className="flex items-center gap-1.5">
            <ThumbsDown size={11} className="text-red-400 flex-shrink-0" />
            <div className="flex-1 h-1.5 bg-bg-elevated rounded-full overflow-hidden">
              <div className="h-full bg-red-400 rounded-full transition-all" style={{ width: `${100 - approvedPct}%` }} />
            </div>
            <span className="text-[10px] text-red-400 w-6 text-right">{data.feedback_rejected}</span>
          </div>

          <div className="mt-1 pt-1 border-t border-border-subtle">
            <div className="text-[10px] text-text-muted">Last distillation</div>
            <div className="text-xs text-text-secondary">{timeAgo(data.last_distillation_at)}</div>
          </div>
        </div>
      </div>
    </div>
  );
}

