// ============================================================================
// PROJECT START DATE — for "Day X of building" counter
// ============================================================================

const PROJECT_START = new Date('2026-02-20T00:00:00.000Z');

function getDayNumber() {
  return Math.floor((Date.now() - PROJECT_START.getTime()) / 86400000) + 1;
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

/**
 * Format a timestamp as "X min ago" / "X hrs ago" / "X days ago"
 * @param {string|null} isoString
 * @returns {string}
 */
function timeAgo(isoString) {
  if (!isoString) return 'never';
  const ms = Date.now() - new Date(isoString).getTime();
  const mins = Math.floor(ms / 60000);
  if (mins < 2) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  return `${days}d ago`;
}

/**
 * Format a dollar amount with appropriate precision
 * @param {number} amount
 * @returns {string}
 */
function formatCost(amount) {
  if (amount === 0) return '$0.00';
  if (amount < 0.01) return `$${amount.toFixed(4)}`;
  return `$${amount.toFixed(2)}`;
}

/**
 * Compute KPI traffic light color
 * @param {number} value
 * @param {number} greenThreshold
 * @param {number} yellowThreshold
 * @param {boolean} higherIsBetter
 * @returns {'green'|'yellow'|'red'}
 */
function kpiColor(value, greenThreshold, yellowThreshold, higherIsBetter = true) {
  if (higherIsBetter) {
    if (value >= greenThreshold) return 'green';
    if (value >= yellowThreshold) return 'yellow';
    return 'red';
  } else {
    // Lower is better (e.g., "days since X")
    if (value <= greenThreshold) return 'green';
    if (value <= yellowThreshold) return 'yellow';
    return 'red';
  }
}

const KPI_COLOR_CLASSES = {
  green:  'text-green-400 bg-green-400/10',
  yellow: 'text-yellow-400 bg-yellow-400/10',
  red:    'text-red-400 bg-red-400/10',
};

