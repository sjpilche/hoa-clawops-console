// ============================================================================
// COMPONENT: KPIBadge
// ============================================================================
/**
 * Single KPI chip with traffic-light coloring.
 *
 * @param {{ label: string, value: number|string, unit?: string, color?: 'green'|'yellow'|'red' }} props
 */
function KPIBadge({ label, value, unit = '', color = 'green' }) {
  return (
    <div className={`flex flex-col items-center px-3 py-1 rounded-md text-xs font-mono ${KPI_COLOR_CLASSES[color]}`}>
      <span className="text-base font-bold leading-tight">{value}{unit}</span>
      <span className="text-[10px] opacity-70 uppercase tracking-wider">{label}</span>
    </div>
  );
}

// ============================================================================
// COMPONENT: FunnelBar
// ============================================================================
/**
 * Horizontal proportional funnel visualization.
 * Each stage width = stage.count / max_count * 100%.
 * Minimum rendered width: 4px per segment (so zero-count stages show as a sliver).
 *
 * @param {{ stages: Array<{label: string, count: number, color: string}> }} props
 */
function FunnelBar({ stages }) {
  const maxCount = Math.max(...stages.map(s => s.count), 1);
  return (
    <div className="flex items-end gap-0.5 h-6 w-full mt-2" title="Pipeline funnel">
      {stages.map((stage) => {
        const pct = Math.max((stage.count / maxCount) * 100, 2);
        return (
          <div
            key={stage.label}
            className={`${stage.color} rounded-sm transition-all duration-500 flex-shrink-0`}
            style={{ width: `${pct}%`, height: '100%', minWidth: '4px' }}
            title={`${stage.label}: ${stage.count}`}
          />
        );
      })}
    </div>
  );
}

// ============================================================================
// COMPONENT: MissionHeader
// ============================================================================
/**
 * Header bar — founder identity strip + live metric chips + quick actions.
 *
 * @param {{ meta: object, ollamaOk: boolean, backupOk: boolean, socketConnected: boolean, onRunTodd: () => void, onRunScout: () => void, onAddIdea: () => void }} props
 */
function MissionHeader({ meta, ollamaOk, backupOk, socketConnected, onRunTodd, onRunScout, onAddIdea }) {
  const dayNumber = getDayNumber();
  const revenueColor = meta.days_since_revenue == null ? 'yellow'
    : kpiColor(meta.days_since_revenue, 7, 30, false);  // higherIsBetter=false

  return (
    <div className="col-span-12 flex items-center justify-between px-4 h-14 bg-bg-surface border border-border-subtle rounded-lg">
      {/* Left — Founder identity */}
      <div className="flex items-center gap-3">
        <Crosshair size={18} className="text-accent-primary" />
        <span className="text-sm font-semibold text-text-primary">Mission Control</span>
        <span className="text-xs text-text-muted">Day {dayNumber} of building</span>
        <span className="text-border-subtle">|</span>
        {/* Socket connection indicator */}
        {socketConnected
          ? <Wifi size={12} className="text-green-400" title="Real-time connected" />
          : <WifiOff size={12} className="text-text-muted" title="Polling mode" />
        }
      </div>

      {/* Center — Live metric strip */}
      <div className="flex items-center gap-2">
        <KPIBadge
          label="cost today"
          value={formatCost(meta.cost_today_usd)}
          color={kpiColor(meta.cost_today_usd, 1.0, 3.0, false)}
        />
        <KPIBadge
          label="running"
          value={meta.agents_running}
          unit=" agents"
          color={meta.agents_running > 0 ? 'green' : 'yellow'}
        />
        <KPIBadge
          label="schedules"
          value={meta.schedules_active}
          unit=" active"
          color="green"
        />
        <KPIBadge
          label="success rate"
          value={`${Math.round(meta.agent_success_rate * 100)}%`}
          color={kpiColor(meta.agent_success_rate, 0.9, 0.75)}
        />
        {/* KPI #10 — days since revenue. Most important. */}
        <KPIBadge
          label="days since $"
          value={meta.days_since_revenue ?? '—'}
          color={revenueColor}
        />
        {/* Status indicators */}
        <div className="flex items-center gap-1.5 ml-1">
          <div
            className={`w-2 h-2 rounded-full ${ollamaOk ? 'bg-green-400' : 'bg-red-400'}`}
            title={`Ollama: ${ollamaOk ? 'available' : 'offline'}`}
          />
          <span className="text-[10px] text-text-muted">Ollama</span>
          <div
            className={`w-2 h-2 rounded-full ml-2 ${backupOk ? 'bg-green-400' : 'bg-yellow-400'}`}
            title={`Backup: ${backupOk ? 'recent' : 'stale'}`}
          />
          <HardDrive size={10} className="text-text-muted" />
        </div>
      </div>

      {/* Right — Quick actions */}
      <div className="flex items-center gap-2">
        <button
          onClick={onRunTodd}
          className="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-md bg-accent-primary/10 hover:bg-accent-primary/20 text-accent-primary border border-accent-primary/20 transition-colors"
          title="Run daily debrief (Todd)"
        >
          <Bot size={12} />
          Run Todd
        </button>
        <button
          onClick={onRunScout}
          className="flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-md bg-bg-elevated hover:bg-bg-surface-hover text-text-secondary border border-border-subtle transition-colors"
          title="Run Jake construction discovery"
        >
          <MapPin size={12} />
          Run Scout
        </button>
        <button
          onClick={onAddIdea}
          className="flex items-center gap-1.5 px-2 py-1.5 text-xs rounded-md bg-bg-elevated hover:bg-bg-surface-hover text-text-muted border border-border-subtle transition-colors"
          title="Add new opportunity idea"
        >
          <Plus size={12} />
          Idea
        </button>
      </div>
    </div>
  );
}

// ============================================================================
// COMPONENT: PipelinePanel
// ============================================================================
/**
 * Reusable pipeline panel — used for both Jake and HOA.
 *
 * @param {{
 *   title: string,
 *   icon: React.ElementType,
 *   accentColor: string,
 *   metrics: Array<{label: string, value: string|number, badge?: string, badgeColor?: string}>,
 *   funnelStages: Array<{label: string, count: number, color: string}>,
 *   lastRunAt: string|null,
 *   lastRunLabel: string
 * }} props
 */
function PipelinePanel({ title, icon: Icon, accentColor, metrics, funnelStages, lastRunAt, lastRunLabel }) {
  const staleness = lastRunAt ? (Date.now() - new Date(lastRunAt).getTime()) / 3600000 : Infinity;
  const stalenessColor = staleness < 2 ? 'bg-green-400' : staleness < 8 ? 'bg-yellow-400' : 'bg-red-400';

  return (
    <div className="col-span-3 bg-bg-surface border border-border-subtle rounded-lg p-3 flex flex-col h-48">
      {/* Panel header */}
      <div className="flex items-center justify-between mb-2">
        <div className="flex items-center gap-2">
          <Icon size={14} className={accentColor} />
          <span className="text-xs font-semibold text-text-muted uppercase tracking-wider">{title}</span>
        </div>
        <div className="flex items-center gap-1.5">
          <div className={`w-1.5 h-1.5 rounded-full ${stalenessColor}`} title={`Last run: ${timeAgo(lastRunAt)}`} />
          <span className="text-[10px] text-text-muted">{lastRunLabel}</span>
        </div>
      </div>

      {/* Metrics grid — 2 columns */}
      <div className="grid grid-cols-2 gap-x-2 gap-y-1 flex-1">
        {metrics.map(({ label, value, badge, badgeColor }) => (
          <div key={label} className="flex items-center justify-between">
            <span className="text-[11px] text-text-muted truncate">{label}</span>
            <div className="flex items-center gap-1">
              <span className="text-sm font-bold text-text-primary">{value}</span>
              {badge && (
                <span className={`text-[9px] px-1 py-0.5 rounded font-semibold ${badgeColor || 'bg-gray-500/20 text-gray-400'}`}>
                  {badge}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

      {/* Mini funnel */}
      {funnelStages && funnelStages.length > 0 && (
        <FunnelBar stages={funnelStages} />
      )}
    </div>
  );
}

