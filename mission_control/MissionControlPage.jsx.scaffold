  };

  const handleRunScout = async () => {
    // Phase 2: POST to create a pending run for jake-construction-discovery
    console.log('[MissionControl] Run Scout clicked — wire in Phase 2');
  };

  const handleAddIdea = () => {
    setShowIdeaModal(true);  // Phase 2: implement modal
    console.log('[MissionControl] Add Idea clicked — wire modal in Phase 2');
  };

  const handleRunTask = async (task) => {
    // Phase 4: POST to create a pending run for task.agent with task.message
    // try {
    //   const agent = await api.get('/agents').then(r => r.agents.find(a => a.name === task.agent_slug));
    //   if (agent) await api.post('/runs', { agent_id: agent.id, message: task.message, trigger: 'manual' });
    //   refresh();
    // } catch (err) { console.error('[MissionControl] Run task failed:', err); }
    console.log('[MissionControl] Run task:', task.title, '— wire in Phase 4');
  };

  // ── Jake pipeline panel config ───────────────────────────────────────────
  const jakeMetrics = [
    { label: 'Total leads',   value: data.jake.total },
    { label: 'With email',    value: data.jake.with_email,  badge: `${data.jake.email_pct?.toFixed(0)}%`, badgeColor: data.jake.email_pct > 25 ? 'bg-green-400/20 text-green-400' : 'bg-yellow-400/20 text-yellow-400' },
    { label: 'In outreach',   value: data.jake.in_outreach },
    { label: 'Replied',       value: data.jake.replied },
    { label: 'HOT leads',     value: data.jake.hot,        badge: data.jake.hot > 0 ? 'HOT' : null, badgeColor: 'bg-orange-400/20 text-orange-400' },
    { label: 'Meetings',      value: data.jake.meetings,   badge: data.jake.meetings > 0 ? 'BOOKED' : null, badgeColor: 'bg-green-400/20 text-green-400' },
  ];
  const jakeFunnel = [
    { label: 'Discovered', count: data.jake.funnel.discovered, color: 'bg-accent-info' },
    { label: 'Enriched',   count: data.jake.funnel.enriched,   color: 'bg-accent-primary' },
    { label: 'Outreach',   count: data.jake.funnel.outreach,   color: 'bg-accent-warning' },
    { label: 'Replied',    count: data.jake.funnel.replied,    color: 'bg-accent-success' },
    { label: 'Meeting',    count: data.jake.funnel.meeting,    color: 'bg-green-400' },
  ];

  // ── HOA pipeline panel config ────────────────────────────────────────────
  const hoaMetrics = [
    { label: 'Discovered',     value: data.hoa.total },
    { label: 'HOT tier',       value: data.hoa.hot,         badge: data.hoa.hot > 0 ? 'HOT' : null,  badgeColor: 'bg-red-400/20 text-red-400' },
    { label: 'WARM tier',      value: data.hoa.warm,        badge: data.hoa.warm > 0 ? 'WARM' : null, badgeColor: 'bg-orange-400/20 text-orange-400' },
    { label: 'Posted',         value: data.hoa.posted },
    { label: 'Pending review', value: data.hoa.pending_review, badge: data.hoa.pending_review > 10 ? '!' : null, badgeColor: 'bg-yellow-400/20 text-yellow-400' },
    { label: 'Geo-targets',    value: data.hoa.geo_targets_active },
  ];
  const hoaFunnel = [
    { label: 'Discovered',  count: data.hoa.funnel.discovered,     color: 'bg-accent-info' },
    { label: 'Hot + Warm',  count: data.hoa.funnel.hot_warm,       color: 'bg-orange-400' },
    { label: 'Drafted',     count: data.hoa.funnel.outreach_drafted, color: 'bg-accent-warning' },
    { label: 'Posted',      count: data.hoa.funnel.posted,         color: 'bg-accent-success' },
    { label: 'Engaged',     count: data.hoa.funnel.engaged,        color: 'bg-green-400' },
  ];

  // ── Render ───────────────────────────────────────────────────────────────
  return (
    <div className="grid grid-cols-12 gap-3 p-4 h-full" style={{ gridTemplateRows: 'auto auto 1fr' }}>

      {/* ROW 1 — HEADER BAR */}
      {/* See MissionHeader component above */}
      <MissionHeader
        meta={data.meta}
        ollamaOk={ollamaOk}
        backupOk={backupOk}
        socketConnected={connected}
        onRunTodd={handleRunTodd}
        onRunScout={handleRunScout}
        onAddIdea={handleAddIdea}
      />

      {/* ROW 2 — FOUR PIPELINE PANELS */}

      {/* JAKE PIPELINE PANEL — cols 1-3 */}
      {/* Data: summary.jake | Refresh: 30s | See Section 3 of dashboard_spec.md */}
      <PipelinePanel
        title="Jake Pipeline"
        icon={Users}
        accentColor="text-accent-primary"
        metrics={jakeMetrics}
        funnelStages={jakeFunnel}
        lastRunAt={data.jake.last_lead_at}
        lastRunLabel={data.jake.last_lead_hours_ago != null ? `${data.jake.last_lead_hours_ago.toFixed(0)}h ago` : 'never'}
      />

      {/* HOA PIPELINE PANEL — cols 4-6 */}
      {/* Data: summary.hoa | Refresh: 30s | See Section 3 of dashboard_spec.md */}
      <PipelinePanel
        title="HOA Pipeline"
        icon={MapPin}
        accentColor="text-accent-warning"
        metrics={hoaMetrics}
        funnelStages={hoaFunnel}
        lastRunAt={data.hoa.last_discovery_at}
        lastRunLabel={data.hoa.last_discovery_hours_ago != null ? `${data.hoa.last_discovery_hours_ago.toFixed(0)}h ago` : 'never'}
      />

      {/* CONTENT ENGINE PANEL — cols 7-9 */}
      {/* Data: summary.content | Refresh: 30s | See Section 3 of dashboard_spec.md */}
      <ContentPanel data={data.content} />

      {/* REVENUE EXPERIMENTS PANEL — cols 10-12 */}
      {/* Data: summary.opportunities | Refresh: on-load | See Section 3 of dashboard_spec.md */}
      <OpportunityPanel data={data.opportunities} onAddIdea={handleAddIdea} />

      {/* ROW 3 — ACTIVITY FEED (left) + RIGHT COLUMN (right) */}

      {/* AGENT ACTIVITY FEED — cols 1-7 */}
      {/* Data: GET /api/runs?limit=25 + Socket.io | See Section 3 of dashboard_spec.md */}
      <ActivityFeed runs={runs} connected={connected} />

      {/* RIGHT COLUMN — cols 8-12 */}
      {/* Stacks Top 3 Today (flex-2) over Memory Pulse (flex-3) */}
      <div className="col-span-5 flex flex-col gap-3">

        {/* TOP 3 TODAY PANEL */}
        {/* Data: summary.top_tasks (from Todd's daily-debrief run) | See Section 3 */}
        <TopThreePanel
          tasks={data.top_tasks || []}
          generatedAt={null}  /* Phase 4: pull from Todd's run completed_at */
          onRunTask={handleRunTask}
        />

        {/* MEMORY PULSE PANEL */}
        {/* Data: summary.brain | Refresh: 5min | See Section 3 of dashboard_spec.md */}
        <MemoryPulse data={data.brain} />

      </div>

      {/* TODO Phase 2: AddOpportunityModal */}
      {/* {showIdeaModal && (
        <AddOpportunityModal
          onClose={() => setShowIdeaModal(false)}
          onSave={async (idea) => {
            await api.post('/opportunities', idea);
            setShowIdeaModal(false);
            refresh();
          }}
        />
      )} */}

    </div>
  );
}

